# =====================================================================
# CodeInsight Platform - Environment Variables
# Copy this file to `.env` and fill in real values for local development.
# Backend reads these via `application-local.yml` (see backend/src/main/resources).
# =====================================================================

# ---------- Database (PostgreSQL) ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=code_insight
DB_USER=postgres
DB_PASSWORD=postgres

# ---------- Redis (远端) ----------
REDIS_HOST=47.97.114.189
REDIS_PORT=6379
REDIS_PASSWORD=YourStrongPassword123

# ---------- Server ----------
SERVER_PORT=8080

# ---------- LLM / AI ----------
# Set LLM_MOCK=true to use the built-in mock provider (no real API call).
LLM_MOCK=true
LLM_API_KEY=
LLM_API_URL=https://api.minimax.io/v1
LLM_MODEL_NAME=MiniMax-M3
# Pipeline AI retry（层级 / 文档次数已拆分）
AI_RETRY_HIERARCHY_MAX_ATTEMPTS=3
AI_RETRY_DOC_MAX_ATTEMPTS=5
AI_RETRY_BACKOFF_MS=1000
# true：层级+文档经 PipelineAiCaller 的重试不限次（取消/额度仍停；见 docs/ai-retry-unlimited-switch-plan.md）
AI_RETRY_UNLIMITED_ATTEMPTS=false
AI_RETRY_UNLIMITED_BACKOFF_CAP_MS=60000
# 可执行知识生成技术栈白名单（逗号分隔，精确匹配目录文案，如 Java 或 Java,Python）
TASK_SUPPORTED_TECH_STACKS=Java
# 仓库 Git 连通性探测（Leader 轮询间隔毫秒 / 单次超时秒 / 并发）
REPO_GIT_CHECK_INTERVAL_MS=180000
REPO_GIT_CHECK_INITIAL_DELAY_MS=180000
REPO_GIT_CHECK_TIMEOUT_SECONDS=15
REPO_GIT_CHECK_CONCURRENCY=3
REPO_GIT_CHECK_BATCH_SIZE=40
REPO_GIT_CHECK_MAX_SWEEP_SECONDS=120
REPO_GIT_CHECK_REACHABLE_TTL_MS=21600000
REPO_GIT_CHECK_UNREACHABLE_TTL_MS=1800000
# 真空仓类型/技术栈：Leader 串行 + COUNT 调度冷却
REPO_STACK_PROBE_ENABLED=true
REPO_STACK_PROBE_INTERVAL_MS=20000
REPO_STACK_PROBE_INITIAL_DELAY_MS=30000
REPO_STACK_PROBE_BATCH_SIZE=30
REPO_STACK_PROBE_TREE_TIMEOUT_MS=45000
REPO_STACK_PROBE_MAX_SWEEP_SECONDS=1800
REPO_STACK_PROBE_LEADER_LOCK_TTL_SECONDS=1800
REPO_STACK_PROBE_ACTIVE_DELAY_MS=20000
REPO_STACK_PROBE_IDLE_BACKOFF_MS=60000,300000,900000
REPO_STACK_PROBE_ON_CREATE=true
REPO_STACK_PROBE_ORPHAN_MAX_AGE_HOURS=2
# 定时 commit 轮询扫描（docs/scheduled-commit-poll-scan-plan.md）
SCAN_ENABLED=true
# 稳健日扫建议：全天每 5 分钟；配合 global-poll + daily-coverage 保证当日补齐
SCAN_CRON=0 */5 * * * *
# true=全局 cron 扫全部远程仓；false=仅 ci_scan_window 命中仓
SCAN_GLOBAL_POLL_ENABLED=true
# 验证开关：有基线且 HEAD 无变化时仍下发 INITIAL
SCAN_FORCE_FULL_ON_UNCHANGED=true
# 按自然日覆盖：超时不记完成、后续 tick 重试，直至当日全部探测
SCAN_DAILY_COVERAGE_ENABLED=true
SCAN_POLL_CONCURRENCY=2
SCAN_POLL_BATCH_SIZE=30
SCAN_MAX_SWEEP_SECONDS=300
SCAN_PROBE_TIMEOUT_SECONDS=30
SCAN_PROBE_MAX_ATTEMPTS=3
SCAN_PROBE_RETRY_BACKOFF_MS=2000
# 文档本机并行 + 等 AI 槽（秒，应 ≫ HTTP 超时）；轮询间隔毫秒
AI_DOC_PARALLELISM=4
AI_DOC_ACQUIRE_WAIT_SECONDS=1800
AI_DOC_ACQUIRE_POLL_INTERVAL_MS=5000
AI_DOC_ACQUIRE_WAIT_UNLIMITED=false
AI_DOC_HTTP_TIMEOUT_SECONDS=120

# ---------- Environment / storage (cluster-shared-storage) ----------
# CODE_INSIGHT_ENV=dev → 写死本机路径 + 强制单机，无需配置 STORAGE_*
# CODE_INSIGHT_ENV=prod → 两根必填绝对路径 + 一律集群调度（含单节点；已删除 CLUSTER_ENABLED）
# dev 额外兜底（误连共享库时）：禁用孤儿接管；自动派发仅 client_ip∈本机；详见 docs/dev-shared-db-safety-plan.md
# 仍应优先使用本地 PostgreSQL，不要依赖该兜底。
CODE_INSIGHT_ENV=dev
# STORAGE_RUNTIME_ROOT=/mnt/nas
# STORAGE_RELEASES_ROOT=/mnt/nas-publish/releases
