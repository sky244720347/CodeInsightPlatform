# =====================================================================
# CodeInsight Platform - Environment Variables
# Copy this file to `.env` and fill in real values for local development.
# Backend reads these via `application-local.yml` (see backend/src/main/resources).
# =====================================================================

# ---------- Database (PostgreSQL) ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=code_insight
DB_USER=postgres
DB_PASSWORD=postgres

# ---------- Redis (远端) ----------
REDIS_HOST=47.97.114.189
REDIS_PORT=6379
REDIS_PASSWORD=YourStrongPassword123

# ---------- Server ----------
SERVER_PORT=8080

# ---------- LLM / AI ----------
# Set LLM_MOCK=true to use the built-in mock provider (no real API call).
LLM_MOCK=true
LLM_API_KEY=
LLM_API_URL=https://api.minimax.io/v1
LLM_MODEL_NAME=MiniMax-M3
# Pipeline AI retry（层级 / 文档次数已拆分）
AI_RETRY_HIERARCHY_MAX_ATTEMPTS=3
AI_RETRY_DOC_MAX_ATTEMPTS=5
AI_RETRY_BACKOFF_MS=1000

# ---------- Environment / storage (cluster-shared-storage) ----------
# CODE_INSIGHT_ENV=dev → 写死本机路径 + 强制单机，无需配置 STORAGE_*
# CODE_INSIGHT_ENV=prod → 两根必填绝对路径 + 一律集群调度（含单节点；已删除 CLUSTER_ENABLED）
CODE_INSIGHT_ENV=dev
# STORAGE_RUNTIME_ROOT=/mnt/nas
# STORAGE_RELEASES_ROOT=/mnt/nas-publish/releases
