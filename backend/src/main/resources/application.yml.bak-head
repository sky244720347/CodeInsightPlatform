spring:
  profiles:
    active: local
  main:
    banner-mode: "off"

mybatis-plus:
  mapper-locations: classpath:mapper/*.xml

# ???????????profile ????? application-{profile}.yml ?????code-insight:
  env: ${CODE_INSIGHT_ENV:dev}
  cluster:
    # enabled ????????ClusterEnvAligner ??env ?????ev=false??? dev=true??    leader-lock-ttl-seconds: 15
    task-lease-hours: 2
    draft-edit-lock-ttl-seconds: 120
    draft-edit-lock-renew-seconds: 60
    # ?????? Redis ?????TL + ???????????????/??? DB ??????
    task-permit-ttl-seconds: 300
    task-permit-renew-seconds: 60
    # ?????? TTL?????? task-permit-reconcile???????????????
    instance-heartbeat-ttl-seconds: 180
    task-permit-reconcile-interval-ms: 30000
    # ??? DB ?????????+ ?????????????????? ?????????????orphan-reclaim-lease-heartbeat-design.md??    task-lease-minutes: 30
    task-lease-grace-minutes: 10
    task-lease-renew-interval-ms: 120000
    orphan-reclaim-interval-ms: 30000
  storage:
    # ??dev ???????????ev ??? ./storage ?????./storage/workspaces??/storage/releases???????????    runtime-root: ${STORAGE_RUNTIME_ROOT:}
    releases-root: ${STORAGE_RELEASES_ROOT:}
  parser:
    # ???????????????
    #   ast-fallback-regex????????? AST???????????? REGEX
    #   ast                       ??? AST?????????????????    #   regex                     ???????????MVP ?????    engine: ast-fallback-regex
  ai:
    hierarchy-parallelism: 4   # ?????? AI ??????????????API ??????
    retry:
      # ???????????????????????????
      hierarchy-max-attempts: 3
      doc-max-attempts: 5
      backoff-ms: 1000           # ??????????????????????? = backoff-ms ? attempt
      # ???????????? AiSummaryServiceImpl.acquireAiPermitWithWait???????????????
      concurrency-backoff-ms: 2000
    doc:
      # ??? A?????????????????docs/doc-generation-guarantee-plan.md ?4
      max-prompt-chars: 100000
      max-method-body-chars: 12000
      http-timeout-seconds: 120
      shrink-factor: 0.5
      # ?????????????????????????????????????????      parallelism: 4
      # ?????MODULE_HIERARCHY ??AI ??????????????? ??http-timeout????????????????????      acquire-wait-seconds: 1800
      # ????????????????????5s?????????
      acquire-poll-interval-ms: 5000
      # true????????????????????????????????? PipelineAiCaller ?????? attempt
      acquire-wait-unlimited: false
  review:
    # true????????????????????????????????????????????????CONFIRMED??    allow-partial-pass: ${REVIEW_ALLOW_PARTIAL_PASS:false}
  schedule:
    enabled: true             # ?????????????????alse ??ScheduleExecutor ????????    poll-interval-ms: 60000    # ???????????????????????? schedule
    queue-poll-interval-ms: 30000  # ???????????UEUE ?????    lock-ttl-seconds: 30       # Redis ?????? TTL
  task:
    queue-dispatch-interval-ms: 5000   # ????????????????????????TaskQueueDispatcher ???
    # ????????????????????????????????????????label??? Java ??Java,Python????????????????????    supported-tech-stacks: ${TASK_SUPPORTED_TECH_STACKS:Java}
  repo:
    # Git ??????????????????????Leader ??????
    git-check-interval-ms: ${REPO_GIT_CHECK_INTERVAL_MS:180000}
    # ????????????????????interval ??????????????????????????????
    git-check-initial-delay-ms: ${REPO_GIT_CHECK_INITIAL_DELAY_MS:180000}
    # ??? ls-remote ????????    git-check-timeout-seconds: ${REPO_GIT_CHECK_TIMEOUT_SECONDS:15}
    # ???/?????????????    git-check-concurrency: ${REPO_GIT_CHECK_CONCURRENCY:3}
